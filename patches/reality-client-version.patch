@@ -28,6 +29,28 @@ import (
 
 const RealityMaxShortIDLen = 8
 
+// RealityClientVersion is the Xray client version reported in the REALITY session ID.
+// Xray-core v26.7.11+ servers reject clients older than 26.3.27 by default (minClientVer),
+// so the hardcoded 1.8.2 no longer works. Override at build time:
+// -ldflags "-X github.com/metacubex/mihomo/component/tls.RealityClientVersion=26.10.21"
+var RealityClientVersion = "26.10.21"
+
+func realityClientVersionBytes() []byte {
+	parts := strings.Split(RealityClientVersion, ".")
+	if len(parts) != 3 {
+		return []byte{26, 10, 21}
+	}
+	b := make([]byte, 3)
+	for i, part := range parts {
+		n, err := strconv.ParseUint(part, 10, 8)
+		if err != nil {
+			return []byte{26, 10, 21}
+		}
+		b[i] = byte(n)
+	}
+	return b
+}
+
 type RealityConfig struct {
 	PublicKey *ecdh.PublicKey
 	ShortID   [RealityMaxShortIDLen]byte
